{
	"$schema": "node_modules/wrangler/config-schema.json",
	/**
	 * ⚠️ GENERATED FILE — do not edit by hand.
	 * Source of truth: infra/env.prod → scripts/gen-wrangler.mjs (pnpm gen:infra).
	 * CI drift gate: pnpm check:infra
	 */
	/**
	 * Studio worker config — the headless Studio SPA (assets) + the /__studio
	 * metadata routes backed by the Studio D1 (see worker/index.ts).
	 *
	 * The core API worker is reached through the private `API` service binding,
	 * never a public URL. Assets serve the SPA with single-page-app fallback.
	 *
	 * Regenerate types after changing bindings: `pnpm cf-typegen` (wrangler types).
	 */
	"name": "mff-sys-studio",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"directory": "./dist",
	},
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "STUDIO_DB",
			"database_name": "mff-sys-studio-db",
			// Studio metadata D1 — created via `npx wrangler d1 create mff-sys-studio-db`.
			"database_id": "c60ea537-555d-4436-8f6a-60fdb8eb97b3",
			// NO preview_database_id — preview/`--remote` must never touch the prod
			// Studio database. Set STUDIO_D1_PREVIEW_ID in infra/env.prod to point at a scratch D1.
		},
	],
	"services": [
		{
			"binding": "API",
			"service": "mff-sys-api",
		},
	],
	"routes": [
		{
			"pattern": "erp-studio.mfflogistics.com",
			"custom_domain": true,
		},
	],
}
