{
	"name": "@mmbix/studio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --port 5174 --strictPort",
		"build": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsc -b && NODE_OPTIONS=--disable-warning=ExperimentalWarning vite build",
		"typecheck": "tsc -b",
		"preview": "npm run build && vite preview",
		"db:build": "node studio.db/build.js",
		"db:check": "node studio.db/check.js",
		"db:d1-export": "node studio.db/d1-export.js",
		"db:dump-seed": "node studio.db/dump-seed.js",
		"db:seed-demos": "node studio.db/seed-demos.js",
		"db:sync-ds": "node studio.db/sync-ds.js",
		"test": "vitest run --config vitest.config.mts",
		"test:watch": "vitest --watch --config vitest.config.mts",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/noto-sans-myanmar": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@mmbix/design-system": "workspace:*",
		"@mmbix/config": "workspace:*",
		"@mmbix/types": "workspace:*",
		"@mmbix/ui-views": "workspace:*",
		"@mmbix/utils": "workspace:*",
		"@scalar/api-reference-react": "^0.9.66",
		"@tanstack/react-query": "catalog:",
		"@tanstack/react-store": "catalog:",
		"@tanstack/store": "catalog:",
		"@tailwindcss/vite": "^4.3.3",
		"lucide-react": "^1.34.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router-dom": "^7.18.2"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.0",
		"@cloudflare/workers-types": "catalog:",
		"@testing-library/dom": "catalog:",
		"@testing-library/react": "catalog:",
		"jsdom": "catalog:",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
