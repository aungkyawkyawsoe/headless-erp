{
	"name": "@mmbix/tgapp",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --port 5175 --strictPort",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"typegen": "mmbix-typegen --schema schema.source.json --out src/generated --name schema.ts",
		"typegen:check": "rm -rf node_modules/.tmp/typegen-check && mmbix-typegen --schema schema.source.json --out node_modules/.tmp/typegen-check --name schema.ts && diff -u src/generated/schema.ts node_modules/.tmp/typegen-check/schema.ts && rm -rf node_modules/.tmp/typegen-check"
	},
	"dependencies": {
		"@fontsource-variable/exo-2": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/noto-sans-myanmar": "^5.3.0",
		"@mmbix/design-system": "workspace:*",
		"@mmbix/sdk": "workspace:*",
		"@mmbix/sdk-react": "workspace:*",
		"@mmbix/types": "workspace:*",
		"@mmbix/utils": "workspace:*",
		"@tanstack/react-query": "catalog:",
		"leaflet": "^1.9.4",
		"lucide-react": "^1.34.0",
		"nuqs": "^2.10.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router-dom": "^7.18.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.2",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.3.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"globals": "^17.7.0",
		"jsdom": "^30.0.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vite": "^8.2.0",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
