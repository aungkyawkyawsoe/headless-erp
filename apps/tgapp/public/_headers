# Cloudflare Workers static-asset headers (parsed at deploy, never served).
#
# Default asset caching is `public, max-age=0, must-revalidate`, so the browser
# revalidates EVERY file on EVERY launch — for this app that's a round trip per
# shell file (entry JS + 10 module-preload chunks + CSS) before it can render,
# which is what makes a reopen feel slow on a weak connection.
#
# Everything Vite emits under /assets/ is content-hashed, so it can be cached
# forever: a repeat launch then paints straight from the disk cache with no
# network round trips at all. A new deploy ships new hashes, so this can never
# serve stale code.
/assets/*
	Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted — cached briefly rather than forever.
/favicon.svg
	Cache-Control: public, max-age=86400

# The document itself. `max-age=0, must-revalidate` (the default) forced a
# blocking round trip on EVERY launch before the browser would even consider the
# disk-cached entry script — the single biggest fixed cost of a reopen on a weak
# connection. A short max-age with a long stale-while-revalidate means a repeat
# launch paints immediately from cache while the fresh copy is fetched in the
# background; a deploy is still picked up within a minute, and the content-hashed
# /assets/* it references can never be stale.
/
	Cache-Control: public, max-age=60, stale-while-revalidate=86400

/index.html
	Cache-Control: public, max-age=60, stale-while-revalidate=86400
