dist/
.wrangler/
.DS_Store
.playwright-mcp/
*.log
*.tsbuildinfo
node_modules/
.turbo/

# Local secrets — never commit
.dev.vars
.env
.env.local
.env.*.local

# Per-client secrets (ADMIN_PASSWORD, JWT_SECRET, tokens)
clients/**/.env
clients/*/.env

# Per-client generated wrangler configs
wrangler.*.jsonc
!wrangler.jsonc
!wrangler.testco.jsonc

# Auto-generated by wrangler types — COMMITTED for the API + frontend apps so a
# fresh clone/CI typechecks without running `wrangler types` first.
worker-configuration.d.ts
!apps/api/worker-configuration.d.ts
!apps/tgapp/worker-configuration.d.ts

# Design-session mockups (visual companion)
.superpowers/

# Operational data dumps (never commit prod/local row data)
apps/api/scripts/backups/
# Ad-hoc import sources (fleet/item exports consumed by scripts/import-*.mjs)
apps/api/_data/

# CLI build artifact — regenerated by `node build.js` (never commit the bundle)
packages/cli/bin/cli.js

# Storybook static build output — regenerated by `pnpm build-storybook`
storybook-static/

# Local D1 backups — contain user data (admin password hash), never commit
apps/api/backups/

# Schema snapshots (IaC) — regenerable schema-only dumps; don't commit new ones
apps/api/snapshots/

# Local dev artifacts
nohup.out
apps/tgapp/nohup.out
apps/tgapp/test-results/
