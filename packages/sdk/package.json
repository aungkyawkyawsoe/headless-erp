{
	"name": "@mmbix/sdk",
	"version": "0.1.0",
	"description": "Typed client SDK for the Mmbix headless entity engine — zero-waste typed queries, auth adapters, offline-ready, schema typegen (types + Zod)",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./typegen": "./src/typegen/index.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"mmbix-typegen": "./bin/typegen.js"
	},
	"files": [
		"dist",
		"bin",
		"src"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "node build.js"
	},
	"dependencies": {
		"@mmbix/config": "workspace:*",
		"@mmbix/types": "workspace:*",
		"picocolors": "^1.1.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.3.0",
		"esbuild": "^0.28.2",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
