/**
 * {{displayName}} Worker
 *
 * {{description}}
 *
 * Runs plugins: {{pluginIds}}
 * Auto-generated by `headless worker create {{workerName}}`
 *
 * Worker Group: {{workerName}}
 * Bundle target: ~{{estimatedSize}}KB
 */

import { Hono } from 'hono';
import { cors } from 'hono/cors';
{{#each pluginImports}}
import { {{this.factory}} } from './plugins/{{this.dir}}/plugin';
{{/each}}

type Env = {
  DB: D1Database;
  ADMIN_PASSWORD: string;
  JWT_SECRET: string;
  {{#each serviceBindings}}
  {{upperCase this}}: Fetcher;
  {{/each}}
};

const app = new Hono<{ Bindings: Env }>();

// ── Middleware ───────────────────────────────────────
app.use('*', cors());

// ── Plugins ──────────────────────────────────────────
{{#each pluginImports}}
// {{this.dir}}: {{this.description}}
const {{this.factory}}Reg = {{this.factory}}().register({
  app,
  env: {},
  d1: undefined as unknown as D1Database,
  config: { isDev: false },
  hooks: {
    // Options-based signature — see packages/types PluginHookAPI.on()
    on() {
      // Hooks wired at plugin init
    },
  },
});
{{this.factory}}Reg.routes?.forEach((r) => app.route(r.path, r.handler));
{{/each}}

// ── Health Check ─────────────────────────────────────
app.get('/health', (c) => c.json({
  status: 'ok',
  worker: '{{workerName}}',
  plugins: [{{#each pluginIds}}'{{this}}'{{#unless @last}}, {{/unless}}{{/each}}],
  timestamp: new Date().toISOString()
}));

export default app;
