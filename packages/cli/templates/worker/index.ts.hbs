/**
 * Worker: {{displayName}}
 *
 * Worker group entry point.
 * Auto-generated by `headless worker:create`
 *
 * Plugins: {{pluginIds}}
 */

import { Hono } from 'hono';
{{#each pluginIds}}
import { {{pluginFactory this}} } from '@/plugins/{{this}}/plugin';
{{/each}}

const app = new Hono();

// ── Register Plugins ──────────────────────────────
const plugins = [
	{{#each pluginIds}}
	{{pluginFactory this}}(),
	{{/each}}
];

for (const plugin of plugins) {
	const reg = plugin.register({
		app,
		env: {},
		d1: undefined as unknown as D1Database,
		config: { isDev: false },
		hooks: {
			// Options-based signature — see packages/types PluginHookAPI.on()
			on(opts: { collection: string; event: string; handler: (doc: Record<string, unknown>, db: D1Database) => void }) {
				// Hooks wired at plugin init
			},
		},
	});

	if (reg.routes) {
		for (const route of reg.routes) {
			app.route(route.path, route.handler);
		}
	}
}

// ── Health Check ─────────────────────────────────
app.get('/health', (c) => c.json({ status: 'ok', worker: '{{workerName}}' }));

export default app;
