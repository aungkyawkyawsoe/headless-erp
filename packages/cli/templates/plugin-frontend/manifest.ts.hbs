/**
 * {{name}} Module — Frontend Manifest (reference)
 *
 * Auto-generated by `headless module create {{id}} --frontend`
 *
 * The frontend is DB-driven: the sidebar dock and module menus are served by
 * the backend (GET /api/modules → /api/modules/:slug/menus). This manifest is
 * a local, typed reference of the module's nav structure — the CLI registers
 * the module itself via POST /api/modules, so this file is optional at runtime.
 */
{{#each iconImports}}
import { {{this}} } from 'lucide-react';
{{/each}}
import type { LucideIcon } from 'lucide-react';
import type { NavMainItem } from '@mmbix/design-system';

export const {{id}}NavItems: NavMainItem[] = [
{{#each navItems}}
	{ title: '{{title}}', url: '/{{../id}}{{url}}', icon: {{icon}},
	{{#if items}}
	items: [
		{{#each items}}
		{ title: '{{title}}', url: '/{{../../id}}{{url}}' },
		{{/each}}
	],
	{{/if}}
	},
{{/each}}
];

/** Local manifest shape (mirrors what the backend stores for the module). */
export interface {{id}}ManifestShape {
	id: string;
	name: string;
	sortOrder: number;
	module: { name: string; icon: LucideIcon };
	nav: { items: NavMainItem[] };
	entityMap: Record<string, string>;
	{{#if hasPages}}
	pages: Record<string, { label: string; loader: () => Promise<unknown> }>;
	{{/if}}
	{{#if serviceBinding}}
	serviceBinding: boolean;
	{{/if}}
}

export const {{id}}Manifest: {{id}}ManifestShape = {
	id: '{{id}}',
	name: '{{name}}',
	sortOrder: {{sortOrder}},
	module: { name: '{{moduleName}}', icon: {{moduleIcon}} },
	nav: { items: {{id}}NavItems },
	entityMap: {
{{#each entityMap}}
		'{{key}}': '{{value}}',
{{/each}}
	},
	{{#if hasPages}}
	pages: {
	{{#each pages}}
		{{id}}: {
			label: '{{label}}',
			loader: () => import('../pages/{{dir}}/{{component}}'),
		},
	{{/each}}
	},
	{{/if}}
	{{#if serviceBinding}}
	serviceBinding: true,
	{{/if}}
};
