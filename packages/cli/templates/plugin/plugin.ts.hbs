import type { Plugin, PluginRegistration, PluginContext } from '@mmbix/types/worker';
import { Hono } from 'hono';

export function {{pluginFactory id}}(): Plugin {
	return {
		id: '{{id}}',
		name: '{{name}}',
		version: '1.0.0',
		register(ctx: PluginContext): PluginRegistration {
{{#if hasHooks}}
			// ── Lifecycle Hooks ──────────────────────────
			// ctx.hooks.on('collection_slug', 'event', async (doc, rawD1, auth) => {
			//   const db = new D1Client(rawD1);
			//   // Your logic here
			// });
{{/if}}

			// ── Custom Routes ────────────────────────────
			type Env = { Bindings: { DB: D1Database }; Variables: { auth: { user_id: string } } };
			const app = new Hono<Env>();

			app.get('/', async (c) => {
				return c.json({ success: true, message: '{{id}} plugin is running' });
			});

			return { routes: [{ path: '/api/{{id}}', handler: app as any }] };
		},
	};
}
