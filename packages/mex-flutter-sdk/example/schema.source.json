[
	{
		"slug": "work_orders",
		"name": "Work Orders",
		"schema_json": {
			"fields": [
				{ "name": "code", "type": "slug", "required": true },
				{ "name": "title", "type": "text", "required": true },
				{ "name": "status", "type": "select", "options": ["draft", "in_progress", "done"], "required": false },
				{ "name": "priority", "type": "integer", "required": false },
				{ "name": "is_billable", "type": "boolean", "required": false },
				{ "name": "rate", "type": "currency", "required": false },
				{ "name": "meta_note", "type": "json", "required": false },
				{ "name": "assigned_to", "type": "m2o", "required": false },
				{ "name": "lines", "type": "o2m", "required": false },
				{ "name": "total", "type": "formula", "store": true, "result_type": "number", "formula": "rate * priority" },
				{ "name": "is_overdue", "type": "formula", "store": true, "result_type": "boolean", "formula": "due_at < NOW()" },
				{ "name": "health_label", "type": "formula", "formula": "title" }
			]
		},
		"system_field_options": {
			"fields": [
				{ "name": "created_at", "type": "timestamp", "required": false },
				{ "name": "updated_at", "type": "timestamp", "required": false }
			]
		}
	},
	{
		"slug": "contacts",
		"name": "Contacts",
		"schema_json": {
			"fields": [
				{ "name": "full_name", "type": "text", "required": true },
				{ "name": "email", "type": "email", "required": false },
				{ "name": "phone", "type": "phone", "required": false }
			]
		}
	}
]
