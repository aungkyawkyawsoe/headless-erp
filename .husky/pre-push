#!/usr/bin/env sh
# Pre-Push Hook — Full Quality Gate Before Push
# Blocked by: ESLint warnings/errors, test failures
# (TypeScript is already gated in pre-commit — no need to run it twice.)
set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

# Skip for tag pushes
if echo "$2" | grep -qE '^refs/tags/|^0000'; then exit 0; fi

echo ""
echo "${YELLOW}═══ Pre-Push Quality Gate ═══════════════════${NC}"

# ── 1. ESLint (zero warnings) ──
# The only ESLint config lives in apps/api — run from that package dir.
echo "${YELLOW} 1/2 ESLint (max-warnings=0)...${NC}"
if (cd apps/api && npx eslint src/ --ext .ts --max-warnings=0) > /tmp/husky-push-eslint.log 2>&1; then
  echo "${GREEN}  ✓ ESLint OK (0 warnings)${NC}"
else
  tail -5 /tmp/husky-push-eslint.log | sed 's/^/  /'
  echo "${RED}  ✗ ESLint errors/warnings — push blocked${NC}"
  exit 1
fi

# ── 2. Tests ──
echo "${YELLOW} 2/2 Tests...${NC}"
if pnpm test > /tmp/husky-push-test.log 2>&1; then
  echo "${GREEN}  ✓ Tests passed${NC}"
else
  tail -5 /tmp/husky-push-test.log | sed 's/^/  /'
  echo "${RED}  ✗ Tests failed — push blocked${NC}"
  exit 1
fi

echo "${GREEN}═══ Quality gate passed — pushing ✓${NC}"
echo ""
