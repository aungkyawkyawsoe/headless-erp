# ─────────────────────────────────────────────────────────────────────────────
# TESTCO infra env — isolated resources for the vitest suite + local wrangler
# dev runs (apps/api/wrangler.testco.jsonc). Generated by scripts/gen-wrangler.mjs
# from this file — do not edit the jsonc by hand.
#
# ⚠️ TEST-ONLY. Never `wrangler deploy -c wrangler.testco.jsonc` into a shared or
# production account: IS_DEV=true + the KNOWN credentials below grant full admin
# to anyone (public dev-token + known admin password). This file deliberately
# isolates every resource from production: own queue names, own R2 bucket,
# placeholder D1 ids (tests run on the local miniflare D1).
#
# Everything here is a known non-production value — no real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Account ────────────────────────────────────────────────────────────────
CF_ACCOUNT_ID=4893d057edb60776ec8bf60c69e29586

# ── Worker name (never deployed; local dev only) ────────────────────────────
WORKER_API=testco-cms

# ── D1 (placeholder ids — miniflare local only, never remote) ───────────────
D1_NAME=testco-cms-db
D1_ID=your-d1-database-id
D1_PREVIEW_ID=your-preview-database-id

# ── R2 (OWN bucket — the old config pointed this var at the PROD tg-mff-r2) ─
R2_BUCKET=testco-cms-media

# ── Queues — ISOLATED from production (the old config produced to + consumed
#    the PROD tg-mff-events queue, competing with the live consumer) ─────────
QUEUE_EVENTS=testco-events
QUEUE_EVENTS_DLQ=testco-events-dlq

# ── Non-secret vars ─────────────────────────────────────────────────────────
ADMIN_USERNAME=dev@mmbics.com
ADMIN_NAME=Administrator
CLIENT_ID=testco
TABLE_PREFIX=cms_
DOMAIN_MODULES=idp
# Test directory gate — the generic fixture collection the auth specs create.
TELEGRAM_DIRECTORY_COLLECTION=directory
TELEGRAM_DIRECTORY_FIELD=etg_id

# Dev mode + known test-only credentials (vars here are fine — this config is
# never deployed and every value is a published test placeholder).
IS_DEV=true
ADMIN_PASSWORD=dev-password-for-local-only
JWT_SECRET=testco-jwt-secret-change-me
TELEGRAM_BOT_TOKEN=test-bot-token
R2_SQL_TOKEN=test-dummy-token

# Feature flags — everything OFF for tests/local dev.
RATE_LIMIT_DO=false
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=7
ANALYTICS_ENABLED=false
ENABLE_R2_LAKE=false
AI_PROVIDER=mock
