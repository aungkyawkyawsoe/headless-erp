# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION infra env — the SINGLE SOURCE OF TRUTH for every Cloudflare
# resource name/id this monorepo talks to (workers, D1, R2, queues, analytics,
# domain, non-secret vars).
#
#   ⚠️ NEVER put secrets here (ADMIN_PASSWORD, JWT_SECRET, BACKUP_ENCRYPTION_KEY,
#      R2_SQL_TOKEN, TELEGRAM_BOT_TOKEN, ENCRYPTION_KEY) — they are set on the
#      worker with `wrangler secret put` and live in git-ignored .dev.vars
#      locally. This file is committed.
#
# ⚠️ GENERATED CONFIGS — do not edit the wrangler jsonc files by hand.
#   infra/env.prod            → apps/api/wrangler.jsonc  +  apps/tgapp/wrangler.jsonc
#   infra/env.testco          → apps/api/wrangler.testco.jsonc
#   Generator: scripts/gen-wrangler.mjs   (regenerate: pnpm gen:infra)
#   CI drift gate:             pnpm check:infra  (deploy.yml quality job)
#
# Client prefix: **mff-sys** (hyphens). R2 bucket + queue names forbid
# underscores (^[a-z0-9-]+$), so the prefix is hyphenated EVERYWHERE for one
# consistent identity. The Analytics dataset is the exception (it REQUIRES
# underscores → mff_sys_api_requests).
#
# Renamed from the old `mff-erp-bot-*` / `tg-mff-*` names on 2026-09-08. The new
# stack is fully live (API worker + miniapp on app.mfflogistics.com). The OLD
# stack (mff-erp-bot-api/-app, tg-mff-d1, tg-mff-events…) is orphaned and is
# deleted once the post-cutover smoke in infra/README.md passes.
# ─────────────────────────────────────────────────────────────────────────────

# ── Account ────────────────────────────────────────────────────────────────
CF_ACCOUNT_ID=4893d057edb60776ec8bf60c69e29586

# ── Worker names ────────────────────────────────────────────────────────────
WORKER_API=mff-sys-api
WORKER_MINIAPP=mff-sys-miniapp
MINIAPP_DOMAIN=app.mfflogistics.com
# Also expose the Mini App at https://<WORKER_MINIAPP>.workers.dev (in addition
# to the branded custom domain). Useful for testing without DNS/domain checks.
# Set false to force the custom domain only.
MINIAPP_WORKERS_DEV=true

# ── Studio worker (admin design UI — /__studio metadata D1-backed) ──────────
WORKER_STUDIO=mff-sys-studio
STUDIO_DOMAIN=erp-studio.mfflogistics.com
# The Studio metadata D1 (component catalog etc.) — create once with
#   npx wrangler d1 create mff-sys-studio-db
# then paste the returned id into STUDIO_D1_ID and run `pnpm gen:infra`.
# Seed it after deploy: `pnpm --filter @mmbix/studio db:d1-export` + wrangler d1 execute.
STUDIO_D1_NAME=mff-sys-studio-db
STUDIO_D1_ID=c60ea537-555d-4436-8f6a-60fdb8eb97b3
# Also expose the Studio at https://<WORKER_STUDIO>.workers.dev alongside the
# custom domain. Set false to force the custom domain only.
STUDIO_WORKERS_DEV=true

# ── D1 ─────────────────────────────────────────────────────────────────────
D1_NAME=mff-sys-db
D1_ID=8d19c262-aac5-42f0-a124-6283d460b054
# Leave D1_PREVIEW_ID EMPTY → `preview_database_id` is omitted from the config so
# preview/`--remote` never touches the production database. Once a scratch
# preview D1 exists, set its id here and regenerate.
D1_PREVIEW_ID=

# ── R2 (created 2026-09-08) ─────────────────────────────────────────────────
R2_BUCKET=mff-sys-media

# ── Queues (created 2026-09-08) ─────────────────────────────────────────────
QUEUE_WEBHOOK=mff-sys-webhook-delivery
QUEUE_WEBHOOK_DLQ=mff-sys-webhook-dlq
QUEUE_EVENTS=mff-sys-events
QUEUE_EVENTS_DLQ=mff-sys-events-dlq

# ── Workers Analytics Engine dataset (auto-creates on first write; underscores
#    are mandatory for dataset names) ────────────────────────────────────────
ANALYTICS_DATASET=mff_sys_api_requests

# ── Non-secret vars (deployed as plaintext vars; typed by `wrangler types`) ─
# Bootstrap admin username — the password is a SECRET (wrangler secret put
# ADMIN_PASSWORD). The engine fails closed in prod until the secret exists.
ADMIN_USERNAME=dev@mmbics.com
TABLE_PREFIX=cms_
DOMAIN_MODULES=hr,idp,mro
# PBKDF2 cost for NEW password hashes. The code default is 600k (OWASP 2023),
# but 600k PBKDF2 throws on the Workers runtime for this deployment (500 on
# login/verify — CPU budget). 100k is verified working. Verification always
# uses each stored hash's own iteration count, so existing hashes are unaffected.
PBKDF2_ITERATIONS=100000

# Feature flags — production defaults. NEVER set IS_DEV here (it enables the
# public dev-token + relaxed limits + trusted unsigned telegram logins).
# RATE_LIMIT_DO=false: the Durable-Object limiter added a `stub.fetch` DO round
# trip to EVERY /api/* request; with low traffic the per-IP DO is constantly cold
# and stalled requests for seconds (Workers analytics: p99 wall 3.75s vs p99 CPU
# 0.25s — pure I/O wait; ~1 subrequest/request). The in-memory per-isolate
# limiter (`rateLimiter()`) still runs and enforces every tier. Re-enable only
# with a scheme that does not block the request path (e.g. Cloudflare edge
# rate-limiting rules, or a fire-and-forget DO increment).
RATE_LIMIT_DO=false
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
ANALYTICS_ENABLED=true
ENABLE_R2_LAKE=true
AI_PROVIDER=mock
